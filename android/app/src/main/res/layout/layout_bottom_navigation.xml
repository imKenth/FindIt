<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- White bar, pushed down 12dp so the circle can poke above it -->
    <LinearLayout
        android:id="@+id/bottom_navigation_container"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <include
            android:id="@+id/nav_home"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="home" />

        <include
            android:id="@+id/nav_search"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="search" />

        <!-- Reports slot: holds only the label, the circle floats above it -->
        <FrameLayout
            android:id="@+id/nav_reports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/nav_reports_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="@string/nav_reports"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:maxLines="1" />
        </FrameLayout>

        <include
            android:id="@+id/nav_my_reports"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="my_reports" />

        <include
            android:id="@+id/nav_profile"
            layout="@layout/item_bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:tag="profile" />
    </LinearLayout>

    <!-- Big circle, higher elevation than the bar so it draws on top -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/nav_reports_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|center_horizontal"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/violet_600"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@string/nav_reports"
            android:src="@drawable/ic_add"
            app:tint="@color/black" />
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>