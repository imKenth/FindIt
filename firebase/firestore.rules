rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reportedById == request.auth.token.email;
      allow update: if request.auth != null
        && (
          request.auth.token.email == 'admin@school.edu'
          || (
            resource.data.reportedById == request.auth.token.email
            && request.resource.data.reportedById == resource.data.reportedById
          )
        );
      allow delete: if request.auth != null
        && (
          request.auth.token.email == 'admin@school.edu'
          || resource.data.reportedById == request.auth.token.email
        );
    }
  }
}
